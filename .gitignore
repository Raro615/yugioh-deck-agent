# 상류에서 계속 갱신되는 데이터는 커밋하지 않는다.
# 받는 방법: python -m scripts.fetch_official_db
data/cards.cdb
data/constants/
data/cache/
data/state/

# 원본 룰북 PDF 는 저작물이라 저장소에 넣지 않는다.
# 추출 결과(data/rules/documents/)만 커밋하고, 원본은 각자 두고 쓴다.
# 받는 곳: https://www.yugioh-card.com/en/rulebook
data/rules/sources/

# 한국어 카드 데이터는 저장소에 포함한다 (data/ko/ko-KR.json).
# 수집 과정의 페이지 캐시만 제외한다.
data/ko/.cache/

__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
