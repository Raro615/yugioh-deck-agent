# 상류에서 계속 갱신되는 데이터는 커밋하지 않는다.
# 받는 방법: python -m scripts.fetch_official_db
data/cards.cdb
data/constants/
data/cache/
data/state/

# 공식 사이트에서 받은 HTML 원본 캐시. 재파싱용이라 다시 받을 수 있고 크다.
# 정규화된 재정(data/rulings/ocg/)만 커밋한다.
data/rulings/.cache/

# 원본 룰북 PDF 는 저작물이라 저장소에 넣지 않는다.
# 추출 결과(data/rules/documents/)만 커밋하고, 원본은 각자 두고 쓴다.
# 받는 곳: https://www.yugioh-card.com/en/rulebook
data/rules/sources/

# 🔴 카드 그림은 코나미의 저작물이라 저장소에 넣지 않는다 (룰북 PDF 와 같은
# 취급). 받는 곳과 이용 조건은 deck/card_images.py 에 적어 두었다.
# 받는 방법: python3 -m scripts.make_replay_viewer --line <경로> --out <파일>
docs/viewer/local/

# 한국어 카드 데이터는 저장소에 포함한다 (data/ko/ko-KR.json).
# 수집 과정의 페이지 캐시만 제외한다.
data/ko/.cache/

# 외부 사이트 조작기(scripts/duel_simulator_driver.js)가 쓰는 Node 의존성.
# 받는 방법: npm install && npx playwright install chromium
node_modules/
package-lock.json

__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# 🔴 Discord 봇 토큰 등 비밀 값. .env.example 만 커밋한다 (Phase 5-A).
.env
.env.*
!.env.example
